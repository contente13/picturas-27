    "ready_timeout_s": 120,
    "scenarios": {
      "R0": {
        "description": "No fault: reference duration, quota and result count"
      },
      "R1": {
        "description": "Worker dies after receiving the request, before any output",
        "arm": {
          "service": "rotate",
          "point": "after_receive",
          "action": "crash",
          "nth": 5
        }
      },
      "R2": {
        "description": "Worker dies while writing the output file",
        "arm": {
          "service": "rotate",
          "point": "during_write",
          "action": "crash",
          "nth": 5
        }
      },
      "R3": {
        "description": "Worker dies after writing the output, before replying",
        "arm": {
          "service": "rotate",
          "point": "after_write",
          "action": "crash",
          "nth": 5
        }
      },
      "R4": {
        "description": "Worker dies after the reply reached the broker, before acknowledging the request",
        "arm": {
          "service": "rotate",
          "point": "after_publish",
          "action": "crash",
          "nth": 5,
          "post_publish_wait_s": 1.0
        }
      },
      "R5a": {
        "description": "Reply delivered twice at once (concurrent duplicates)",
        "arm": {
          "service": "rotate",
          "point": "after_publish",
          "action": "duplicate",
          "nth": 5,
          "copies": 2,
          "gap_s": 0
        }
      },
      "R5b": {
        "description": "Reply delivered twice, 2 s apart (late duplicate)",
        "arm": {
          "service": "rotate",
          "point": "after_publish",
          "action": "duplicate",
          "nth": 5,
          "copies": 2,
          "gap_s": 2
        }
      },
      "R6a": {
        "description": "Orchestrator dies while advancing a step (before registering the successor)",
        "arm": {
          "service": "projects",
          "point": "before_successor_create",
          "nth": 5
        }
      },
      "R6b": {
        "description": "Orchestrator dies before persisting a final result",
        "arm": {
          "service": "projects",
          "point": "before_result_create",
          "nth": 5
        }
      },
      "R6c": {
        "description": "Orchestrator dies before consolidating (committing) the run",
        "arm": {
          "service": "projects",
          "point": "before_commit",
          "nth": 1
        }
      },
      "R7a": {
        "description": "Cancel and restart while an old reply is held; the old reply is then delivered",
        "arm": {
          "service": "rotate",
          "point": "before_publish",
          "action": "hold",
          "nth": 1,
          "hold_timeout_s": 300
        },
        "cancel_restart": true
      },
      "R7b": {
        "description": "Cancel and restart while an old write is held; the old write then lands on the new run",
        "arm": {
          "service": "rotate",
          "point": "before_write",
          "action": "hold",
          "nth": 1,
          "hold_timeout_s": 300
        },
        "cancel_restart": true
      },
      "R8": {
        "description": "Permanent error (invalid effect parameter): no endless retries, error surfaced",
        "pipeline_override": [
          {
            "procedure": "brightness",
            "params": {
              "brightness": "not-a-number"
            }
          }
        ],
        "expect_failure": true
      }
    }
  },
